{
  "name": "akcat-auth-isolated-test",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "d1_databases": [{ "binding": "DB", "database_name": "akcat-auth-isolated-test-db", "database_id": "11111111-1111-4111-8111-111111111111" }],
  "vars": {
    "AUTH_ALLOWED_ORIGINS": "http://localhost:5173",
    "AUTH_INSECURE_LOCAL_COOKIE": "true",
    "AUTH_ENABLE_MOBILE_BEARER": "false"
  },
  "ratelimits": [
    { "name": "AUTH_IP_RATE_LIMITER", "namespace_id": "872642001", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_ACCOUNT_RATE_LIMITER", "namespace_id": "872642002", "simple": { "limit": 5, "period": 60 } }
  ]
}
