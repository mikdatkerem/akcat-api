{
  "name": "cloudflare-workers-openapi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply akcat-db --local",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/auth.test.mjs tests/reports.test.mjs tests/adjustments.test.mjs tests/audit.test.mjs tests/migrations.test.mjs tests/local-fixes.test.mjs tests/users.test.mjs tests/account.test.mjs tests/reliability.test.mjs tests/walk-in.test.mjs tests/finance-filters.test.mjs",
    "audit:performance": "node --experimental-strip-types tests/performance-audit.mjs",
    "bootstrap:admin": "node --experimental-strip-types scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "chanfana": "^3.3.0",
    "hono": "^4.12.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  }
}
